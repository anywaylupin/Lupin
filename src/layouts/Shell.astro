---
import { Font } from "astro:assets";
import HiveChrome from "../components/HiveChrome.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/overlay.css";

interface Props {
  title: string;
  description: string;
  hive?: boolean;
  ogImage?: string;
}

const { title, description, hive = true, ogImage = "/og/home.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05040b" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-zh" />
    {hive && <script is:inline>
      document.documentElement.classList.add("js");
    </script>}
  </head>
  <body>
    {hive && <HiveChrome />}
    <main id="content">
      <slot />
    </main>
  </body>
</html>
