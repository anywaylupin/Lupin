---
import { DATA_ELEMENT_ID } from "../hive/data";
import { getHiveData, serializeData } from "../lib/content";
import { site } from "../site";
import Icon from "./Icon.astro";
import "../styles/overlay.css";
import "../styles/settings.css";

const data = serializeData(await getHiveData());
const reversedEmail = [...site.email].reverse().join("");
const switches = [
  ["glitch", "Glitch"],
  ["decrypt", "Text decrypt"],
  ["electric", "Electric borders"],
  ["life", "City traffic and lights"],
  ["weather", "Rain and storms"],
] as const;
---

<div class="chrome">
  <div id="city" aria-hidden="true"></div>
  <canvas id="hive" aria-hidden="true"></canvas>
  <p class="sr" id="hive-title">
    Portfolio
  </p>
  <div id="path" aria-hidden="true"></div>
  <nav id="cells" aria-labelledby="hive-title"></nav>
  <section id="leaf" hidden aria-labelledby="leaf-title">
    <div class="leaf-inner" id="leaf-inner" tabindex="-1"></div>
    <button class="hexbtn" id="leaf-back" type="button" data-tip="Back" aria-label="Back">
      <Icon name="back" />
    </button>
  </section>
  <div id="settings">
    <button
      id="settings-btn"
      type="button"
      data-tip="Effects and sound"
      aria-label="Effects and sound"
      aria-expanded="false"
      aria-controls="menu"
    >
      <Icon name="sliders" />
    </button>
    <section id="menu" hidden aria-labelledby="menu-title">
      <div class="menu-head">
        <h2 id="menu-title">
          <b aria-hidden="true">❯</b>config --effects
        </h2>
        <button id="menu-close" type="button" aria-label="Close settings">
          <Icon name="close" />
        </button>
      </div>
      {switches.map(([pref, label]) => (
        <div class="row">
          <span id={`l-${pref}`}>{label}</span>
          <button
            class="switch"
            type="button"
            role="switch"
            aria-checked="false"
            data-pref={pref}
            aria-labelledby={`l-${pref}`}
          ></button>
        </div>
      ))}
      <div class="divider"></div>
      <div class="row">
        <span id="l-sound">Brown noise</span>
        <button
          class="switch"
          type="button"
          role="switch"
          aria-checked="false"
          data-pref="sound"
          aria-labelledby="l-sound"
        ></button>
      </div>
      <div class="row">
        <label for="volume">Volume</label>
        <input type="range" id="volume" min="0" max="1" step="0.05" />
      </div>
      <div class="divider"></div>
      <div class="row">
        <span>Put the loose hexes back</span>
        <button class="textbtn" id="reset" type="button">
          Reset
        </button>
      </div>
    </section>
  </div>
  <div class="contact" id="contacts" role="group" aria-label="Contact">
    <a class="hexbtn" data-tip="GitHub" href={site.github} target="_blank" rel="noopener" aria-label="GitHub">
      <Icon name="code" />
    </a>
    <a class="hexbtn" data-tip="LinkedIn" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <Icon name="profile" />
    </a>
    <button
      class="hexbtn"
      type="button"
      data-tip="Copy email"
      data-email={reversedEmail}
      aria-label="Copy email address"
    >
      <Icon name="mail" />
    </button>
    <a class="hexbtn" data-tip="Download CV" href={site.cv} download aria-label="Download CV as PDF">
      <Icon name="file" />
    </a>
  </div>
  <svg id="map" aria-hidden="true"></svg>
  <div id="tip" hidden aria-hidden="true"></div>
</div>
<script type="application/json" id={DATA_ELEMENT_ID} set:html={data} />
<script>
  import { boot } from "../hive/main";

  try {
    boot();
  } catch (err) {
    document.documentElement.classList.remove("js", "hive");
    console.error(err);
  }
</script>
