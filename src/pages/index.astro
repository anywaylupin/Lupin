---
import CardList from "../components/CardList.astro";
import Shell from "../layouts/Shell.astro";
import { getHiveData, HOME_TITLE } from "../lib/content";
import { site } from "../site";

const { home } = await getHiveData();
---

<Shell title={HOME_TITLE} description={site.description}>
  <CardList
    cmd="ls ~"
    title={site.name}
    intro={site.description}
    cards={home.map((c) => ({ title: c.label, icon: c.icon, text: c.sub, href: c.path }))}
  />
</Shell>
